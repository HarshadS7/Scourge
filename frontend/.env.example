# ==============================================================================
# SCOURGE FRONTEND ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

# ==============================================================================
# BLOCKCHAIN CONFIGURATION
# ==============================================================================

# Monad Testnet RPC URL
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz

# Monad Mainnet RPC URL (when available)
# NEXT_PUBLIC_MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz

# Chain ID (Monad Testnet)
NEXT_PUBLIC_CHAIN_ID=41454

# Block Explorer URL
NEXT_PUBLIC_EXPLORER_URL=https://testnet-explorer.monad.xyz

# ==============================================================================
# SMART CONTRACT ADDRESSES
# ==============================================================================
# These will be populated after deploying contracts

# IdentityNFT Contract Address
NEXT_PUBLIC_IDENTITY_NFT_ADDRESS=0x...

# IdentityRegistry Contract Address
NEXT_PUBLIC_IDENTITY_REGISTRY_ADDRESS=0x...

# CampaignManager Contract Address
NEXT_PUBLIC_CAMPAIGN_MANAGER_ADDRESS=0x...

# Escrow Contract Address
NEXT_PUBLIC_ESCROW_ADDRESS=0x...

# SubmissionVerifier Contract Address
NEXT_PUBLIC_SUBMISSION_VERIFIER_ADDRESS=0x...

# Groth16Verifier Contract Address
NEXT_PUBLIC_GROTH16_VERIFIER_ADDRESS=0x...

# ==============================================================================
# FILECOIN / IPFS STORAGE CONFIGURATION
# ==============================================================================

# Web3.Storage API Token
# Get your free token at: https://web3.storage
NEXT_PUBLIC_WEB3_STORAGE_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Alternative: Lighthouse.storage API Key
# Get your API key at: https://lighthouse.storage
# NEXT_PUBLIC_LIGHTHOUSE_API_KEY=...

# IPFS Gateway URL (for fetching files)
NEXT_PUBLIC_IPFS_GATEWAY=https://w3s.link/ipfs

# Alternative IPFS Gateways (fallbacks)
# NEXT_PUBLIC_IPFS_GATEWAY_FALLBACK_1=https://ipfs.io/ipfs
# NEXT_PUBLIC_IPFS_GATEWAY_FALLBACK_2=https://cloudflare-ipfs.com/ipfs

# ==============================================================================
# APPLICATION CONFIGURATION
# ==============================================================================

# Application Name
NEXT_PUBLIC_APP_NAME=Scourge

# Platform Fee (in basis points, e.g., 250 = 2.5%)
NEXT_PUBLIC_PLATFORM_FEE=250

# Fee Recipient Address
NEXT_PUBLIC_FEE_RECIPIENT=0x...

# ==============================================================================
# WALLETCONNECT (Optional - for RainbowKit)
# ==============================================================================

# WalletConnect Project ID
# Get your free project ID at: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# ==============================================================================
# ANALYTICS & MONITORING (Optional)
# ==============================================================================

# Google Analytics ID (Optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry DSN (Optional)
# NEXT_PUBLIC_SENTRY_DSN=https://...

# ==============================================================================
# DEVELOPMENT / TESTING (Optional)
# ==============================================================================

# Enable debug mode
NEXT_PUBLIC_DEBUG=false

# Mock data for testing
NEXT_PUBLIC_USE_MOCK_DATA=false

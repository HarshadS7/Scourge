# Copy this file to .env and fill in your values
# NEVER commit the actual .env file!

# Monad Network Configuration (Mainnet - Chain ID: 143)
# Choose one of the public RPC endpoints:
MONAD_RPC_URL=https://rpc.monad.xyz
# Alternatives:
# MONAD_RPC_URL=https://rpc1.monad.xyz
# MONAD_RPC_URL=https://rpc2.monad.xyz
# MONAD_RPC_URL=https://rpc3.monad.xyz

# Deployer Private Key (DO NOT SHARE OR COMMIT)
PRIVATE_KEY=0x...

# Fee Recipient Address (defaults to deployer if not set)
FEE_RECIPIENT=0x...

# Monad Block Explorer API Key (for contract verification)
MONAD_EXPLORER_API_KEY=your_api_key_here

# Optional: Testnet Configuration
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
